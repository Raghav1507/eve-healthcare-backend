# TEMPLATE — copy to `.env`, then fill in real values:
#     cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
#
# .env is git-ignored. NEVER put real credentials in any committed file.

# ---- PostgreSQL (must match the values you start the DB with) ----
POSTGRES_USER=eve
POSTGRES_PASSWORD=change_me_use_a_strong_password
POSTGRES_DB=eve_healthcare

# Used by the app/tests when running OUTSIDE docker (host venv).
# Replace the password part with the SAME value as POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+psycopg://eve:change_me_use_a_strong_password@localhost:5433/eve_healthcare

# ---- Auth ----
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_generate_a_random_32_byte_hex
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
